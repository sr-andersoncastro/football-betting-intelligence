# Football Betting Intelligence - Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME="Football Betting Intelligence"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
# For local development with Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/football_betting
# For production (Neon, Railway, etc.):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# API-Football (https://www.api-football.com/)
# Free tier: 100 requests/day
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_RATE_LIMIT=100

# football-data.org (https://www.football-data.org/)
# Free tier available for major European leagues
FOOTBALL_DATA_KEY=your_football_data_key_here
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# The Odds API (https://the-odds-api.com/)
# Free tier: 500 requests/month
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Sync Configuration
SYNC_INTERVAL_MINUTES=60
SYNC_HISTORICAL_DAYS=30
SYNC_UPCOMING_DAYS=7

# Competitions to track (API-Football IDs)
# 71=Brasileirão A, 72=Brasileirão B, 39=Premier League, 140=La Liga,
# 78=Bundesliga, 135=Serie A, 61=Ligue 1, 2=Champions League, 3=Europa League
COMPETITIONS=[71,72,39,140,78,135,61,2,3]

# Model Configuration
MIN_MATCHES_FOR_MODEL=10
DEFAULT_ELO_K_FACTOR=20.0
DEFAULT_HOME_ADVANTAGE=0.3
POISSON_MAX_GOALS=10
DIXON_COLES_RHO=0.1

# Value Betting
MIN_EDGE_PERCENT=2.0
MIN_EV_PERCENT=5.0
MAX_KELLY_FRACTION=0.25
CONFIDENCE_THRESHOLD=0.6

# Risk Management
MAX_EXPOSURE_PER_MATCH=0.05
MAX_DAILY_EXPOSURE=0.20
MAX_DRAWDOWN_PERCENT=15.0

# CORS Origins (for frontend)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8080","http://localhost:8501"]